---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import NewsCard from '@/components/NewsCard.astro';
import { locales, useTranslations, type Locale } from '@/i18n/ui';
import { byDateDesc, getLocalized } from '@/lib/content';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const news = (await getLocalized('news', lang)).sort(byDateDesc);
---

<BaseLayout lang={lang} title={t('news.title')} description={t('news.description')}>
  <PageHero lang={lang} title={t('news.title')} lead={t('news.description')} path="news" />
  <section class="section">
    <div class="container">
      {
        news.length ? (
          <div class="grid grid-3">
            {news.map((n, i) => (
              <NewsCard
                lang={lang}
                slug={n.slug}
                title={n.data.title}
                description={n.data.description}
                date={n.data.date}
                cover={n.data.cover}
                delay={(i % 3) * 80}
              />
            ))}
          </div>
        ) : (
          <p>{t('news.empty')}</p>
        )
      }
    </div>
  </section>
</BaseLayout>
