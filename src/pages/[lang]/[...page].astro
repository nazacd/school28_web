---
import { render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { locales, type Locale } from '@/i18n/ui';
import { getLocalizedEntry } from '@/lib/content';
import { pagePaths, type PageId } from '@/lib/routes';

// Generic text pages from src/content/pages/<lang>/<id>.md, published at the paths in pagePaths.
export async function getStaticPaths() {
  return locales.flatMap((lang) =>
    Object.entries(pagePaths).map(([id, path]) => ({ params: { lang, page: path }, props: { id: id as PageId } })),
  );
}

const lang = Astro.params.lang as Locale;
const { id } = Astro.props;
const path = pagePaths[id];
const entry = await getLocalizedEntry('pages', lang, id);
if (!entry) throw new Error(`Missing content file: src/content/pages/uz/${id}.md`);
const { Content } = await render(entry);
---

<PageLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  heroImage={entry.data.hero_image}
  updated={entry.data.updated}
>
  <Content />
</PageLayout>
