---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { locales, useTranslations, type Locale } from '@/i18n/ui';
import { url } from '@/lib/routes';

// Shown after the contact form is sent without JavaScript.
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('contact.thanks.title')} description={t('contact.thanks.text')} noindex>
  <section class="section">
    <div class="container container--narrow thanks">
      <span class="thanks__icon" data-reveal="scale"><Icon name="check" size={36} /></span>
      <h1 data-reveal>{t('contact.thanks.title')}</h1>
      <p class="lead" data-reveal>{t('contact.thanks.text')}</p>
      <a class="btn" href={url(lang)} data-reveal>{t('contact.thanks.back')}<Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .thanks__icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--accent-50);
    color: var(--accent);
    margin-bottom: 24px;
  }
</style>
