---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { mainNav, url } from '@/lib/routes';
import { useTranslations, type Locale } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const settings = await getSettings();
const current = Astro.url.pathname;

const isActive = (path: string) => {
  const href = url(lang, path);
  return current === href || current.startsWith(href);
};
const groupActive = (paths: string[]) => paths.some(isActive);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo
      href={url(lang)}
      name={settings.name[lang]}
      tagline={settings.tagline[lang]}
      logo={settings.logo}
      monogram={settings.short_name}
    />

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="nav__item nav__item--has-children">
                <a
                  href={url(lang, item.path)}
                  class:list={['nav__link', { 'is-active': groupActive(item.children.map((c) => c.path)) }]}
                  aria-haspopup="true"
                >
                  {t(item.key)}
                  <Icon name="chevron" size={16} class="nav__chevron" />
                </a>
                <ul class="nav__dropdown">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={url(lang, child.path)}
                        class:list={['nav__sublink', { 'is-active': current === url(lang, child.path) }]}
                        aria-current={current === url(lang, child.path) ? 'page' : undefined}
                      >
                        {t(child.key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  href={url(lang, item.path)}
                  class:list={['nav__link', { 'is-active': isActive(item.path) }]}
                  aria-current={current === url(lang, item.path) ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="nav__mobile-extra">
        <LanguageSwitcher lang={lang} />
      </div>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher lang={lang} class="lang--desktop" />
      <button
        class="burger"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('menu.open')}
        data-label-close={t('menu.close')}
      >
        <span class="sr-only">{t('menu.open')}</span>
        <span class="burger__lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header) {
    // Shrink + add background once the page is scrolled.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && toggle) {
    const label = toggle.querySelector('.sr-only')!;
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    background: rgb(251 250 248 / 0.72);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s, background-color 0.3s;
  }
  .site-header.is-scrolled {
    background: rgb(255 255 255 / 0.9);
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px -18px rgb(28 26 27 / 0.35);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: var(--header-h);
    transition: height 0.35s var(--ease);
  }
  .site-header.is-scrolled .site-header__inner {
    height: 64px;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ----- Desktop nav ----- */
  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 999px;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--ink-2);
    transition: color 0.2s, background-color 0.2s;
    white-space: nowrap;
  }
  .nav__link:hover,
  .nav__item:focus-within > .nav__link {
    color: var(--ink);
    background: var(--surface-2);
  }
  .nav__link.is-active {
    color: var(--brand);
  }
  .nav__chevron {
    transition: transform 0.3s var(--ease);
  }
  .nav__item:hover .nav__chevron,
  .nav__item:focus-within .nav__chevron {
    transform: rotate(180deg);
  }
  .nav__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    min-width: 250px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
  }
  .nav__dropdown::before {
    /* hover bridge so the menu doesn't close in the gap */
    content: '';
    position: absolute;
    inset: -10px 0 auto;
    height: 10px;
  }
  .nav__item:hover .nav__dropdown,
  .nav__item:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .nav__sublink {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-2);
    transition: background-color 0.2s, color 0.2s, padding-left 0.3s var(--ease);
  }
  .nav__sublink:hover {
    background: var(--brand-50);
    color: var(--brand);
    padding-left: 18px;
  }
  .nav__sublink.is-active {
    color: var(--brand);
  }
  .nav__mobile-extra {
    display: none;
  }

  /* ----- Burger ----- */
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    place-items: center;
  }
  .burger__lines {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }
  .burger__lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.35s var(--ease), opacity 0.2s, top 0.35s var(--ease);
  }
  .burger__lines span:nth-child(1) { top: 0; }
  .burger__lines span:nth-child(2) { top: 6px; }
  .burger__lines span:nth-child(3) { top: 12px; }
  .is-open .burger__lines span:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .is-open .burger__lines span:nth-child(2) { opacity: 0; }
  .is-open .burger__lines span:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* ----- Mobile nav ----- */
  @media (max-width: 1079px) {
    .site-header {
      /* backdrop-filter would make the fixed menu panel position relative to the header */
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgb(251 250 248 / 0.97);
    }
    .burger {
      display: grid;
    }
    .site-header__actions :global(.lang--desktop) {
      display: none;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      padding: 12px var(--gutter) 40px;
      background: var(--bg);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0.3s;
    }
    .site-header.is-scrolled .nav {
      inset-block-start: 64px;
    }
    .is-open .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav__item {
      border-bottom: 1px solid var(--line);
    }
    .nav__link {
      width: 100%;
      padding: 16px 4px;
      font-size: 1.15rem;
      border-radius: 0;
      background: none !important;
    }
    .nav__chevron {
      display: none;
    }
    .nav__dropdown {
      position: static;
      min-width: 0;
      padding: 0 0 12px 8px;
      border: 0;
      box-shadow: none;
      background: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__dropdown::before {
      display: none;
    }
    .nav__item:hover .nav__dropdown,
    .nav__item:focus-within .nav__dropdown {
      transform: none;
    }
    .nav__sublink {
      padding: 10px 12px;
    }
    .nav__mobile-extra {
      display: block;
      padding-top: 24px;
    }
    /* stagger items in when the menu opens */
    .nav__item {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    }
    .is-open .nav__item {
      opacity: 1;
      transform: none;
    }
    .is-open .nav__item:nth-child(2) { transition-delay: 40ms; }
    .is-open .nav__item:nth-child(3) { transition-delay: 80ms; }
    .is-open .nav__item:nth-child(4) { transition-delay: 120ms; }
    .is-open .nav__item:nth-child(5) { transition-delay: 160ms; }
    .is-open .nav__item:nth-child(6) { transition-delay: 200ms; }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
